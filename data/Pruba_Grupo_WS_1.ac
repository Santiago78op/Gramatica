console.log("\n** Comparaciones y lógica **\n");

console.log("5 == 5: " + (5 == 5)); // Igualdad
console.log("5 == \"5\": " + (5 == "5")); // Igualdad entre entero y cadena
console.log("4.2 == 4.2: " + (4.2 == 4.2)); // Decimal == Decimal
console.log("5 < 7: " + (5 < 7)); // Menor que
console.log("'a' < 'b': " + ('a' < 'b')); // Comparación de caracteres
console.log("true && false: " + (true && false)); // Y lógico
console.log("true || false: " + (true || false)); // O lógico
console.log("!(10 < 5): " + (!(10 < 5))); // Negación lógica

