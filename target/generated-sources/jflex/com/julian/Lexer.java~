  private static final String ZZ_ATTRIBUTE_PACKED_0 =
    "\1\0\1\10\2\11\3\1\2\11\2\1\3\11\1\1"+
    "\1\11\1\1\1\11\2\1\2\11\24\1\4\11\1\1"+
    "\2\11\1\0\1\11\1\0\1\11\2\0\2\11\1\0"+
